<svg width="1280" height="280" viewBox="0 0 1280 280" xmlns="http://www.w3.org/2000/svg" font-family="'Helvetica Neue', Arial, sans-serif">
  <defs>
    <linearGradient id="bg" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#06101e"/>
      <stop offset="100%" stop-color="#0a1320"/>
    </linearGradient>
    <linearGradient id="signal" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="#21d4c4"/>
      <stop offset="100%" stop-color="#3aa0ff"/>
    </linearGradient>
    <pattern id="grid" width="32" height="32" patternUnits="userSpaceOnUse">
      <path d="M32 0H0V32" fill="none" stroke="#ffffff" stroke-opacity="0.035" stroke-width="1"/>
    </pattern>
    <radialGradient id="glow" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#21d4c4" stop-opacity="0.18"/>
      <stop offset="100%" stop-color="#21d4c4" stop-opacity="0"/>
    </radialGradient>
    <style>
      .ring { transform-origin: 1050px 140px; animation: pulse 4s ease-in-out infinite; }
      .ring2 { transform-origin: 1050px 140px; animation: pulse 4s ease-in-out infinite 1.3s; }
      .scan { animation: sweep 6s linear infinite; transform-origin: 1050px 140px; }
      .dot { animation: blink 2.4s ease-in-out infinite; }
      @keyframes pulse { 0% { transform: scale(0.4); opacity: 0.9; } 100% { transform: scale(1.6); opacity: 0; } }
      @keyframes sweep { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
      @keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: 0.25; } }
    </style>
  </defs>

  <rect width="1280" height="280" fill="url(#bg)"/>
  <rect width="1280" height="280" fill="url(#grid)"/>
  <circle cx="1050" cy="140" r="180" fill="url(#glow)"/>

  <!-- left: name + stance -->
  <text x="80" y="118" fill="#ffffff" font-size="46" font-weight="800" letter-spacing="1">Michale McCarthy</text>
  <text x="82" y="156" fill="#7a8aa0" font-size="18" letter-spacing="3">DEVELOPER &amp; SECURITY ENGINEER</text>
  <rect x="82" y="180" width="40" height="3" fill="#21d4c4"/>
  <text x="82" y="214" fill="#9fb0c4" font-size="19" font-family="'Courier New', monospace">The hard decisions belong in the code.</text>

  <!-- right: radar mark -->
  <g>
    <circle class="ring" cx="1050" cy="140" r="50" fill="none" stroke="#21d4c4" stroke-width="2"/>
    <circle class="ring2" cx="1050" cy="140" r="50" fill="none" stroke="#3aa0ff" stroke-width="2"/>
    <circle cx="1050" cy="140" r="56" fill="none" stroke="url(#signal)" stroke-width="2.5"/>
    <line x1="980" y1="140" x2="1120" y2="140" stroke="#ff6b5e" stroke-width="2.5"/>
    <line class="scan" x1="1050" y1="140" x2="1050" y2="84" stroke="#21d4c4" stroke-width="2" stroke-opacity="0.7"/>
    <circle class="dot" cx="1050" cy="140" r="6" fill="#ff6b5e"/>
  </g>
</svg>
